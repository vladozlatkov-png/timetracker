# Tailscale-only sync API. Never expose through cloudflared without Cloudflare Access.
# Secrets: put TT_BEARER_TOKEN and DATABASE_URL in Vaultwarden / Docker secrets — not in git.

PORT=8787
# Example Tailscale hostname of the postgres container host:
# DATABASE_URL=postgres://tt_sync:SECRET@postgres_audit:5432/audit
DATABASE_URL=postgres://user:pass@localhost:5432/audit
TT_BEARER_TOKEN=replace-me-with-a-long-random-token
TZ=Europe/Sofia
