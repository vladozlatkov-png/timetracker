<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.vlado.claude-dream</string>

    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/.claude/skills/dream/scripts/run_dream.sh</string>
    </array>

    <!-- 03:00 local time, every day. If the Mac is asleep at 03:00, launchd
         runs the job at the next wake rather than skipping the day. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <!-- run_dream.sh keeps its own dated logs; these catch anything that fails
         before logging starts, which is where PATH problems surface. -->
    <key>StandardOutPath</key>
    <string>__HOME__/.claude/dream/logs/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.claude/dream/logs/launchd.err.log</string>

    <key>WorkingDirectory</key>
    <string>__HOME__</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>__HOME__</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <!-- Dreaming is strictly background work; never let it compete with
         anything the user is doing. -->
    <key>ProcessType</key>
    <string>Background</string>
    <key>Nice</key>
    <integer>5</integer>

    <key>LowPriorityIO</key>
    <true/>
</dict>
</plist>
