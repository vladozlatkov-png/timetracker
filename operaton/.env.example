# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- Operaton engine ---------------------------------------------------------
# Pin to an explicit 2.x tag before this touches a real engagement.
OPERATON_VERSION=latest
# Interface the engine port binds to. The REST API is UNAUTHENTICATED by
# default — keep this on loopback and reach it over Tailscale, or put an
# authenticating reverse proxy in front before changing it.
OPERATON_BIND=127.0.0.1

# --- Engine's own database (NOT the Audit OS database) -----------------------
ENGINE_DB_NAME=operaton
ENGINE_DB_USER=operaton
ENGINE_DB_PASSWORD=

# --- Audit OS database (the existing workflow.* / orchestrator.* Postgres) ---
# libpq DSN, e.g. postgresql://audit_os:...@192.168.68.77:5432/audit_os
AUDIT_OS_DSN=

# --- Outbound integrations ---------------------------------------------------
# Every one of these is REQUIRED for its handler to run. Unset means the
# handler raises an incident rather than silently succeeding — see README
# "Fail loudly". Do not work around this by stubbing a success response.
SANCTIONS_API_URL=
AUDIT_STEP_DISPATCH_URL=
PBC_CHASE_WEBHOOK=
ISSUE_REPORT_WEBHOOK=

# --- Worker tuning -----------------------------------------------------------
WORKER_ID=external-tasks-1
MIRROR_INTERVAL_SECONDS=60
