<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:operaton="http://operaton.org/schema/1.0/bpmn"
                  id="Definitions_statutory_audit"
                  targetNamespace="http://audit-partners.eu/bpmn">

  <!--
    Statutory audit engagement — PROCESS CONTROL ONLY.

    This model owns phase transitions, human approvals, timers and incidents.
    It deliberately does NOT model the 31-step audit programme: those steps live
    in the step registry (see sql/001_bridge_schema.sql) and are executed by the
    multi-instance call activity below. Adding a step must never require
    redeploying this process definition or migrating running instances.
  -->
  <bpmn:process id="statutory-audit" name="Statutory audit engagement" isExecutable="true"
                operaton:historyTimeToLive="P10Y">

    <!-- ACCEPTANCE ======================================================= -->

    <bpmn:startEvent id="StartEvent_EngagementCreated" name="Engagement created">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_SanctionsCheck" name="Sanctions &#38; PEP screening"
                      operaton:type="external" operaton:topic="sanctions-check">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="Task_ConfirmIndependence" name="Confirm independence (G-INDEPENDENCE)"
                   operaton:candidateGroups="partners">
      <bpmn:extensionElements>
        <operaton:formData>
          <operaton:formField id="independenceConfirmed" label="Independence confirmed (IESBA / ISQM 1)" type="boolean">
            <operaton:validation>
              <operaton:constraint name="required" />
            </operaton:validation>
          </operaton:formField>
          <operaton:formField id="independenceNote" label="Threats identified and safeguards applied" type="string" />
        </operaton:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_AcceptanceOk" name="Accept engagement?" default="Flow_05">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="EndEvent_Declined" name="Engagement declined">
      <bpmn:incoming>Flow_05</bpmn:incoming>
    </bpmn:endEvent>

    <!-- PLANNING ========================================================= -->

    <bpmn:userTask id="Task_ApproveMateriality" name="Approve materiality"
                   operaton:candidateGroups="partners">
      <bpmn:extensionElements>
        <operaton:formData>
          <operaton:formField id="materialityBasis" label="Benchmark" type="enum">
            <operaton:value id="revenue" name="Revenue" />
            <operaton:value id="total_assets" name="Total assets" />
            <operaton:value id="profit_before_tax" name="Profit before tax" />
            <operaton:value id="equity" name="Equity" />
          </operaton:formField>
          <operaton:formField id="overallMateriality" label="Overall materiality" type="long">
            <operaton:validation>
              <operaton:constraint name="required" />
            </operaton:validation>
          </operaton:formField>
          <operaton:formField id="performanceMateriality" label="Performance materiality" type="long">
            <operaton:validation>
              <operaton:constraint name="required" />
            </operaton:validation>
          </operaton:formField>
          <operaton:formField id="trivialThreshold" label="Clearly trivial threshold" type="long" />
        </operaton:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_ApproveRisk" name="Approve risk assessment"
                   operaton:candidateGroups="partners">
      <bpmn:extensionElements>
        <operaton:formData>
          <operaton:formField id="riskAssessmentComplete" label="Risk assessment complete" type="boolean">
            <operaton:validation>
              <operaton:constraint name="required" />
            </operaton:validation>
          </operaton:formField>
          <operaton:formField id="significantRisks" label="Significant risks (incl. fraud)" type="string" />
          <operaton:formField id="eqcrRequired" label="EQCR required (G-EQCR)" type="boolean" />
        </operaton:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
    </bpmn:userTask>

    <!-- FIELDWORK ======================================================== -->

    <bpmn:serviceTask id="Task_LoadRegistry" name="Load step registry"
                      operaton:type="external" operaton:topic="load-step-registry">
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:callActivity id="Call_Fieldwork" name="Fieldwork steps"
                       operaton:calledElement="audit-step">
      <bpmn:extensionElements>
        <operaton:in source="engagementId" target="engagementId" />
        <operaton:in source="auditStep" target="auditStep" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics operaton:collection="${fieldworkSteps}"
                                             operaton:elementVariable="auditStep" />
    </bpmn:callActivity>

    <bpmn:boundaryEvent id="Boundary_PbcChase" name="Every 7 days"
                        attachedToRef="Call_Fieldwork" cancelActivity="false">
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_PbcChase">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/P7D</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>

    <bpmn:serviceTask id="Task_PbcChase" name="Chase outstanding PBC"
                      operaton:type="external" operaton:topic="pbc-chase">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="EndEvent_ChaseSent" name="Chase sent">
      <bpmn:incoming>Flow_11</bpmn:incoming>
    </bpmn:endEvent>

    <!-- COMPLETION ======================================================= -->

    <bpmn:userTask id="Task_GoingConcern" name="Going concern conclusion (G-GC)"
                   operaton:candidateGroups="partners">
      <bpmn:extensionElements>
        <operaton:formData>
          <operaton:formField id="goingConcernConclusion" label="Conclusion" type="enum">
            <operaton:validation>
              <operaton:constraint name="required" />
            </operaton:validation>
            <operaton:value id="appropriate" name="Going concern basis appropriate" />
            <operaton:value id="material_uncertainty" name="Material uncertainty — disclose" />
            <operaton:value id="inappropriate" name="Basis inappropriate" />
          </operaton:formField>
          <operaton:formField id="goingConcernNote" label="Basis for conclusion" type="string" />
        </operaton:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_EqcrRequired" name="EQCR required?" default="Flow_14">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_Eqcr" name="Engagement quality control review"
                   operaton:candidateGroups="eqcr">
      <bpmn:extensionElements>
        <operaton:formData>
          <operaton:formField id="eqcrCleared" label="EQCR cleared — report may be signed" type="boolean">
            <operaton:validation>
              <operaton:constraint name="required" />
            </operaton:validation>
          </operaton:formField>
          <operaton:formField id="eqcrNote" label="Reviewer observations" type="string" />
        </operaton:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_EqcrJoin">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_CompletionChecklist" name="Sign completion checklist"
                   operaton:candidateGroups="engagement-team">
      <bpmn:extensionElements>
        <operaton:formData>
          <operaton:formField id="completionChecklistSigned" label="Completion checklist signed" type="boolean">
            <operaton:validation>
              <operaton:constraint name="required" />
            </operaton:validation>
          </operaton:formField>
        </operaton:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:userTask>

    <!-- REPORTING ======================================================== -->

    <bpmn:userTask id="Task_PartnerSignoff" name="Partner sign-off"
                   operaton:candidateGroups="partners">
      <bpmn:extensionElements>
        <operaton:formData>
          <operaton:formField id="partnerSignoff" label="Report approved for issue" type="boolean">
            <operaton:validation>
              <operaton:constraint name="required" />
            </operaton:validation>
          </operaton:formField>
          <operaton:formField id="opinionType" label="Opinion" type="enum">
            <operaton:value id="unmodified" name="Unmodified" />
            <operaton:value id="qualified" name="Qualified" />
            <operaton:value id="adverse" name="Adverse" />
            <operaton:value id="disclaimer" name="Disclaimer of opinion" />
          </operaton:formField>
        </operaton:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="Task_IssueReport" name="Issue report &#38; lock file"
                      operaton:type="external" operaton:topic="issue-report">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="EndEvent_Closed" name="Engagement closed">
      <bpmn:incoming>Flow_19</bpmn:incoming>
    </bpmn:endEvent>

    <!-- DEADLINE WATCH (non-interrupting event sub-process) ================ -->

    <bpmn:subProcess id="SubProcess_DeadlineWatch" name="Deadline watch" triggeredByEvent="true">
      <bpmn:startEvent id="StartEvent_DeadlineTimer" name="Warning date reached" isInterrupting="false">
        <bpmn:outgoing>Flow_20</bpmn:outgoing>
        <bpmn:timerEventDefinition id="TimerDef_Deadline">
          <bpmn:timeDate xsi:type="bpmn:tFormalExpression">${deadlineWarningAt}</bpmn:timeDate>
        </bpmn:timerEventDefinition>
      </bpmn:startEvent>

      <bpmn:userTask id="Task_EscalateDeadline" name="Delivery deadline at risk — decide"
                     operaton:candidateGroups="partners">
        <bpmn:extensionElements>
          <operaton:formData>
            <operaton:formField id="escalationDecision" label="Decision" type="enum">
              <operaton:value id="on_track" name="On track — no action" />
              <operaton:value id="add_resource" name="Add resource" />
              <operaton:value id="renegotiate" name="Renegotiate deadline with client" />
            </operaton:formField>
            <operaton:formField id="escalationNote" label="Note" type="string" />
          </operaton:formData>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_20</bpmn:incoming>
        <bpmn:outgoing>Flow_21</bpmn:outgoing>
      </bpmn:userTask>

      <bpmn:endEvent id="EndEvent_Escalated" name="Escalation handled">
        <bpmn:incoming>Flow_21</bpmn:incoming>
      </bpmn:endEvent>

      <bpmn:sequenceFlow id="Flow_20" sourceRef="StartEvent_DeadlineTimer" targetRef="Task_EscalateDeadline" />
      <bpmn:sequenceFlow id="Flow_21" sourceRef="Task_EscalateDeadline" targetRef="EndEvent_Escalated" />
    </bpmn:subProcess>

    <!-- FLOWS ============================================================ -->

    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_EngagementCreated" targetRef="Task_SanctionsCheck" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_SanctionsCheck" targetRef="Task_ConfirmIndependence" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_ConfirmIndependence" targetRef="Gateway_AcceptanceOk" />
    <bpmn:sequenceFlow id="Flow_04" name="accept" sourceRef="Gateway_AcceptanceOk" targetRef="Task_ApproveMateriality">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${sanctionsClear &#38;&#38; independenceConfirmed}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_05" name="decline" sourceRef="Gateway_AcceptanceOk" targetRef="EndEvent_Declined" />
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_ApproveMateriality" targetRef="Task_ApproveRisk" />
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_ApproveRisk" targetRef="Task_LoadRegistry" />
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_LoadRegistry" targetRef="Call_Fieldwork" />
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Call_Fieldwork" targetRef="Task_GoingConcern" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Boundary_PbcChase" targetRef="Task_PbcChase" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_PbcChase" targetRef="EndEvent_ChaseSent" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_GoingConcern" targetRef="Gateway_EqcrRequired" />
    <bpmn:sequenceFlow id="Flow_13" name="yes" sourceRef="Gateway_EqcrRequired" targetRef="Task_Eqcr">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${eqcrRequired}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_14" name="no" sourceRef="Gateway_EqcrRequired" targetRef="Gateway_EqcrJoin" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_Eqcr" targetRef="Gateway_EqcrJoin" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Gateway_EqcrJoin" targetRef="Task_CompletionChecklist" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_CompletionChecklist" targetRef="Task_PartnerSignoff" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_PartnerSignoff" targetRef="Task_IssueReport" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_IssueReport" targetRef="EndEvent_Closed" />

  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_statutory_audit">
    <bpmndi:BPMNPlane id="BPMNPlane_statutory_audit" bpmnElement="statutory-audit">

      <bpmndi:BPMNShape id="Shape_StartEvent_EngagementCreated" bpmnElement="StartEvent_EngagementCreated">
        <dc:Bounds x="152" y="162" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="130" y="205" width="82" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_SanctionsCheck" bpmnElement="Task_SanctionsCheck">
        <dc:Bounds x="238" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_ConfirmIndependence" bpmnElement="Task_ConfirmIndependence">
        <dc:Bounds x="388" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_AcceptanceOk" bpmnElement="Gateway_AcceptanceOk" isMarkerVisible="true">
        <dc:Bounds x="538" y="155" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="524" y="118" width="79" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndEvent_Declined" bpmnElement="EndEvent_Declined">
        <dc:Bounds x="545" y="302" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="527" y="345" width="73" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_ApproveMateriality" bpmnElement="Task_ApproveMateriality">
        <dc:Bounds x="638" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_ApproveRisk" bpmnElement="Task_ApproveRisk">
        <dc:Bounds x="788" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_LoadRegistry" bpmnElement="Task_LoadRegistry">
        <dc:Bounds x="938" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Call_Fieldwork" bpmnElement="Call_Fieldwork">
        <dc:Bounds x="1088" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Boundary_PbcChase" bpmnElement="Boundary_PbcChase">
        <dc:Bounds x="1120" y="202" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1162" y="222" width="66" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_PbcChase" bpmnElement="Task_PbcChase">
        <dc:Bounds x="1088" y="300" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndEvent_ChaseSent" bpmnElement="EndEvent_ChaseSent">
        <dc:Bounds x="1238" y="322" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1230" y="365" width="53" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_GoingConcern" bpmnElement="Task_GoingConcern">
        <dc:Bounds x="1238" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_EqcrRequired" bpmnElement="Gateway_EqcrRequired" isMarkerVisible="true">
        <dc:Bounds x="1388" y="155" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1378" y="118" width="71" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Eqcr" bpmnElement="Task_Eqcr">
        <dc:Bounds x="1488" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_EqcrJoin" bpmnElement="Gateway_EqcrJoin" isMarkerVisible="true">
        <dc:Bounds x="1638" y="155" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_CompletionChecklist" bpmnElement="Task_CompletionChecklist">
        <dc:Bounds x="1738" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_PartnerSignoff" bpmnElement="Task_PartnerSignoff">
        <dc:Bounds x="1888" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_IssueReport" bpmnElement="Task_IssueReport">
        <dc:Bounds x="2038" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndEvent_Closed" bpmnElement="EndEvent_Closed">
        <dc:Bounds x="2188" y="162" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="2166" y="205" width="82" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_SubProcess_DeadlineWatch" bpmnElement="SubProcess_DeadlineWatch" isExpanded="true">
        <dc:Bounds x="300" y="440" width="380" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_StartEvent_DeadlineTimer" bpmnElement="StartEvent_DeadlineTimer">
        <dc:Bounds x="340" y="502" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="322" y="545" width="73" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_EscalateDeadline" bpmnElement="Task_EscalateDeadline">
        <dc:Bounds x="420" y="480" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndEvent_Escalated" bpmnElement="EndEvent_Escalated">
        <dc:Bounds x="570" y="502" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="551" y="545" width="75" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Edge_Flow_01" bpmnElement="Flow_01">
        <di:waypoint x="188" y="180" /><di:waypoint x="238" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_02" bpmnElement="Flow_02">
        <di:waypoint x="338" y="180" /><di:waypoint x="388" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_03" bpmnElement="Flow_03">
        <di:waypoint x="488" y="180" /><di:waypoint x="538" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_04" bpmnElement="Flow_04">
        <di:waypoint x="588" y="180" /><di:waypoint x="638" y="180" />
        <bpmndi:BPMNLabel><dc:Bounds x="598" y="162" width="32" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_05" bpmnElement="Flow_05">
        <di:waypoint x="563" y="205" /><di:waypoint x="563" y="302" />
        <bpmndi:BPMNLabel><dc:Bounds x="568" y="240" width="37" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_06" bpmnElement="Flow_06">
        <di:waypoint x="738" y="180" /><di:waypoint x="788" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_07" bpmnElement="Flow_07">
        <di:waypoint x="888" y="180" /><di:waypoint x="938" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_08" bpmnElement="Flow_08">
        <di:waypoint x="1038" y="180" /><di:waypoint x="1088" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_09" bpmnElement="Flow_09">
        <di:waypoint x="1188" y="180" /><di:waypoint x="1238" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_10" bpmnElement="Flow_10">
        <di:waypoint x="1138" y="238" /><di:waypoint x="1138" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_11" bpmnElement="Flow_11">
        <di:waypoint x="1188" y="340" /><di:waypoint x="1238" y="340" />
      </bpmndi:BPMNEdge>
